{
  "name": "remote-pdf-printer-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox-Erweiterung: PDFs aus WebApp an den eigenen Druckserver senden",
  "scripts": {
    "lint": "web-ext lint --ignore-files package.json package-lock.json",
    "build": "web-ext build --overwrite-dest --ignore-files package.json package-lock.json",
    "run": "web-ext run --start-url https://app.example.org --ignore-files package.json package-lock.json",
    "sign": "web-ext sign --channel=unlisted --ignore-files package.json package-lock.json"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  }
}
